{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["hub", "plugins", "install"],
  "properties": {
    "hub": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "displayName": { "type": "string" }, "enginesDsh": { "type": "string" } }
    },
    "install": { "type": "object", "properties": { "mode": { "const": "symbolic-link" }, "mount": { "const": "single-bundle" } } },
    "adapterDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "components": { "type": "array", "items": { "type": "object", "required": ["name", "path"], "properties": { "name": { "type": "string" }, "path": { "type": "string" } } } },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "unit"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "unit": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
